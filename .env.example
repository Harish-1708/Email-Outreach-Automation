# ---- Google Sheets (service account) ----
# Paste the FULL JSON of your service account key as a single line,
# OR store it as a GitHub Secret named GOOGLE_SERVICE_ACCOUNT_JSON.
GOOGLE_SERVICE_ACCOUNT_JSON={}

# ---- Email accounts (SMTP send / IMAP read, App Passwords) ----
# One JSON object holding every sending account. Add as many as you like —
# no other secret or workflow file needs to change to add an account.
# Generate each app_password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on that account).
EMAIL_ACCOUNTS_JSON={"sales1": {"address": "sales1@yourdomain.com", "app_password": "xxxx xxxx xxxx xxxx"}}

# ---- Campaign ----
CAMPAIGN_NAME=sample_campaign
